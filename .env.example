# Application Config
APP_ENV=development
APP_PORT=8080
APP_NAME=asset-pulse-api
HTTP_TIMEOUT=30
HTTP_RETRY_COUNT=3

# JWT Config
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Database Config
DB_HOST=capstone.techx-dev.com
DB_PORT=5432
DB_NAME=asset_pulse_db
DB_USERNAME=techx
DB_PASSWORD=TechX1234!
SSL_MODE=disable
SSL_ROOT_CERT=
TIME_ZONE=Asia/Bangkok

# Azure OpenAI Config
# Setup instructions:
# 1. Create Azure OpenAI resource at https://portal.azure.com
# 2. Deploy a GPT-4 model in your resource
# 3. Get API key from "Keys and Endpoint" section
# 4. Copy endpoint URL (should end with .openai.azure.com/)
# 5. Use your model deployment name for AZURE_OPENAI_MODEL
AZURE_OPENAI_KEY=your-azure-openai-api-key-here
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
AZURE_OPENAI_MODEL=gpt-4